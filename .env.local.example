# Neon Postgres – Console → Dashboard → Connect (connection string, pooled)
DATABASE_URL=postgresql://<user>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/neondb?sslmode=require

# Neon Auth – Console → Auth → Settings → Better Auth → Project Info
NEON_AUTH_BASE_URL=https://<auth-endpoint>
# Secret ký cookie session, tối thiểu 32 ký tự: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=<random-32+-chars>
